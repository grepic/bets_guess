# SmartBets Pro - Environment Configuration
# Copy to .env and fill in values

# Database
SMARTBETS_DATABASE_URL=postgresql+asyncpg://smartbets:smartbets@localhost:5432/smartbets
SMARTBETS_DATABASE_URL_SYNC=postgresql://smartbets:smartbets@localhost:5432/smartbets

# Redis
SMARTBETS_REDIS_URL=redis://localhost:6379/0
SMARTBETS_CELERY_BROKER_URL=redis://localhost:6379/1
SMARTBETS_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated origins)
SMARTBETS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth
SMARTBETS_ADMIN_TOKEN=dev-admin-token

# Real API providers (TODO: get production keys)
SMARTBETS_ODDS_API_KEY=
SMARTBETS_STATS_API_KEY=

# Debug
SMARTBETS_DEBUG=true
